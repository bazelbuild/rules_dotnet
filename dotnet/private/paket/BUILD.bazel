load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "lock",
    srcs = ["lock.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "dependencies",
    srcs = ["dependencies.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":lock"],
)

bzl_library(
    name = "feed",
    srcs = ["feed.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["@bazel_tools//tools/build_defs/repo:utils.bzl"],
)

bzl_library(
    name = "extension",
    srcs = ["extension.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":dependencies",
        ":feed",
        ":lock",
        "//dotnet/private/rules/nuget:nuget_repo",
    ],
)
