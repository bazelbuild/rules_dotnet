load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "publish_binary",
)

publish_binary(
    name = "native_aot",
    binary = "//dotnet/private/tests/publish/app_to_publish",
    native_aot = True,
    self_contained = True,
    # The native link needs a toolchain for the target platform, and Windows
    # goes through MSVC rather than the Unix driver this supports.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    target_framework = "net10.0",
)

# We tar the output because that way we can strip the
# prefix of the files and avoid long path issues on Windows.
# This also makes sure that it's possible to tar the output
# of the publish without any problems
pkg_tar(
    name = "tar",
    srcs = [":native_aot"],
    include_runfiles = True,
    mode = "0755",
    package_dir = "/",
    strip_prefix = select(
        {
            "//dotnet/private:linux-x64": "native_aot/aot/linux-x64",
            "//dotnet/private:linux-arm64": "native_aot/aot/linux-arm64",
            "//dotnet/private:osx-x64": "native_aot/aot/osx-x64",
            "//dotnet/private:osx-arm64": "native_aot/aot/osx-arm64",
        },
    ),
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

sh_test(
    name = "native_aot_test",
    srcs = [
        "test.sh",
    ],
    data = [":tar"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# Cross-compiling proves the two halves are configured independently: ilc runs
# on the execution platform while the framework, the static libraries and the
# linker all come from the target.
publish_binary(
    name = "cross_publish",
    binary = "//dotnet/private/tests/publish/native_aot/app",
    native_aot = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

platform_transition_binary(
    name = "transitioned_linux_x86_64",
    binary = ":cross_publish",
    tags = ["manual"],
    target_platform = ":linux_x86_64",
)

sh_test(
    name = "cross_compile_test",
    size = "small",
    srcs = ["cross_compile_test.sh"],
    args = ["$(rlocationpath :transitioned_linux_x86_64)"],
    data = [
        ":transitioned_linux_x86_64",
        "@bazel_tools//tools/bash/runfiles",
    ],
)
