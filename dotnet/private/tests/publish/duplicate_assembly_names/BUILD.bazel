load("//dotnet:defs.bzl", "csharp_binary", "csharp_library", "publish_binary")
load(":tests.bzl", "duplicate_assembly_names_test")

# Two libraries whose assemblies are both called `lib.dll`, reached through
# branches that never see each other: each of `a` and `b` compiles against only
# one of them, so nothing is wrong until the publish flattens both into one
# directory.
csharp_library(
    name = "lib_one",
    srcs = ["One.cs"],
    out = "lib",
    target_frameworks = ["net10.0"],
)

csharp_library(
    name = "lib_two",
    srcs = ["Two.cs"],
    out = "lib",
    target_frameworks = ["net10.0"],
)

csharp_library(
    name = "a",
    srcs = ["A.cs"],
    target_frameworks = ["net10.0"],
    deps = [":lib_one"],
)

csharp_library(
    name = "b",
    srcs = ["B.cs"],
    target_frameworks = ["net10.0"],
    deps = [":lib_two"],
)

csharp_binary(
    name = "app",
    srcs = ["Main.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        ":a",
        ":b",
    ],
)

publish_binary(
    name = "publish",
    binary = ":app",
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_binary(
    name = "publish_ready_to_run",
    binary = ":app",
    ready_to_run = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

# A plain publish used to drop one of the two silently and produce an app that
# fails when it loads.
duplicate_assembly_names_test(
    name = "publish_test",
    size = "small",
    target_under_test = ":publish",
)

# A ReadyToRun publish used to reach Bazel as two crossgen2 actions writing one
# path, reported as conflicting actions against a file the user never named.
duplicate_assembly_names_test(
    name = "publish_ready_to_run_test",
    size = "small",
    target_under_test = ":publish_ready_to_run",
)
