load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# A flag controlling if strict dependencies are enforced or not.
bool_flag(
    name = "strict_deps",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# A flag controlling if the C# compile actions run in a persistent worker. Off
# while the worker is new; see docs/README.md#persistent-workers.
bool_flag(
    name = "use_compiler_worker",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# A flag controlling if a compile reports the references it did not use, so that
# Bazel stops re-running it when only those change. Needs the compiler worker,
# which reads the compiled output. Off by default because of the trade documented
# in docs/README.md#pruning-unused-references.
bool_flag(
    name = "prune_unused_references",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)
